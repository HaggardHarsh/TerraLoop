# ─── Firebase Admin SDK ────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single line, or point to the file:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Firebase Project ──────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ─── Google Cloud Vision API ───────────────────
# Enable "Cloud Vision API" at console.cloud.google.com → APIs & Services
# Create an API key under Credentials
VISION_API_KEY=your-google-cloud-vision-api-key

# ─── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,file://
